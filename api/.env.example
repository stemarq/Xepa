# Copie para api/.env e preencha os valores.
#
#     cp .env.example .env
#
# Só DATABASE_URL é obrigatória — o resto tem padrão embutido e pode ficar
# como está. A API recusa subir sem ela, de propósito.
#
# Para rodar sem instalar Postgres nenhum, não precisa deste arquivo:
# `npm run dev:memoria` sobe tudo sobre PGlite (Postgres em WASM).

# ---------------------------------------------------------------------
# Banco (PostgreSQL)
# ---------------------------------------------------------------------

# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xepa

# Postgres local: o banco precisa existir antes. Crie com
#   createdb xepa
# ou, de dentro do psql:
#   CREATE DATABASE xepa;
#
# Postgres gerenciado: copie a connection string que o provedor dá e ligue o
# DB_SSL abaixo. Alguns exemplos de como a URL costuma vir:
#   Neon      postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/xepa
#   Railway   postgresql://postgres:senha@containers-xxx.railway.app:5432/railway
#
# Se a senha tiver @ : / ? # ou &, ela precisa ir codificada na URL
# (@ vira %40, # vira %23), senão o driver corta a string no lugar errado.
#
# ---------------------------------------------------------------------
# Supabase pelo pooler
# ---------------------------------------------------------------------
#
# Pegue a string em Project Settings → Database → Connection string, aba
# "Connection pooling". São três endereços diferentes, e eles não são
# intercambiáveis:
#
#   Transaction (6543)  postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#   Session (5432)      postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   Direta (5432)       postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres
#
# Três detalhes que derrubam a conexão:
#
# 1. No pooler o usuário é `postgres.SEU_REF`, **não** `postgres`. Com o
#    usuário errado o erro é de autenticação e não diz que o problema é esse.
# 2. A conexão direta é **IPv6-only**. Em rede sem IPv6 ela falha com timeout
#    ou ENETUNREACH — é o motivo de usar o pooler.
# 3. DB_SSL=true é obrigatório em qualquer um dos três.
#
# Qual porta usar aqui: **6543 (transaction)** para a API. O driver `pg` não
# nomeia prepared statements, então é compatível com esse modo, e as
# transações do `withTransaction` seguem íntegras porque abrem BEGIN/COMMIT
# explícito — o pooler segura a mesma conexão do BEGIN ao COMMIT.
#
# Para `npm run db:migrate`, prefira a **5432 (session)**: migration é DDL
# longa e sessão dedicada evita surpresa. Dá para trocar a URL só nessa hora:
#
#   DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres" npm run db:migrate
#
# ⚠️  NÃO rode `npm run db:reset` no Supabase. Ele executa
#     DROP SCHEMA public CASCADE, que além de apagar suas tabelas derruba os
#     grants que o Supabase mantém para anon/authenticated/service_role — o
#     schema volta sem eles e o projeto fica quebrado. Para recomeçar,
#     derrube só as tabelas do Xepa, ou use o botão de reset do painel.

# Conexão TLS com o banco.
#
# **Todo Postgres gerenciado exige.** Vazio segue o NODE_ENV: ligado só em
# produção. Apontando para a nuvem em desenvolvimento, ponha true aqui — sem
# isso a conexão falha com algo como "server does not support SSL" ou
# "connection terminated unexpectedly", que não parece um erro de TLS.
DB_SSL=

# Conexões simultâneas no pool do lado da API.
#
# Atrás de um pooler (Supabase/Supavisor, PgBouncer) mantenha baixo: quem
# multiplexa as conexões do servidor é ele, e um pool grande aqui só ocupa
# slot à toa. 5 é folgado para desenvolvimento.
DB_POOL_MAX=10

# Depois de configurar, crie o schema e os dados de apoio:
#   npm run db:migrate     aplica as migrations de src/db/migrations/
#   npm run db:seed        insere avatares e instituições
#   npm run db:reset       recria do zero (apaga tudo)
#
# Para conferir se a conexão está de pé antes de tudo:
#   psql "$DATABASE_URL" -c "select version()"

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------

PORT=3333
NODE_ENV=development

# ---------------------------------------------------------------------
# Sessão e recuperação de senha
# ---------------------------------------------------------------------

# RNF09 — a sessão expira em 30 minutos de inatividade
SESSION_TTL_MINUTES=30

# RF005 — validade do token de redefinição de senha
RESET_TOKEN_TTL_MINUTES=30

# ---------------------------------------------------------------------
# Integrações
# ---------------------------------------------------------------------

# Importação de notas da instituição (RF023). Vazio = indisponível, que é o
# normal — a maioria das instituições não expõe integração e a entrada manual
# (RF024) é o caminho principal. "stub" devolve notas fixas, só fora de
# produção, para testar o fluxo.
INSTITUICAO_INTEGRACAO=

# Serviço de E-mail. Sem SMTP_HOST, o link de redefinição é apenas logado
# no console (modo de desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nao-responda@xepa.app

# Base usada para montar o link de redefinição enviado por e-mail
APP_RESET_URL=xepa://redefinir-senha

# Open Finance (RF034–RF037) não tem variável: o provedor hoje é o simulado,
# em memória. Um agregador de verdade traria chave e segredo próprios — ver a
# seção "Open Finance" no CLAUDE.md.

# Open Finance — agregador autorizado pelo Banco Central (RNF18).
#
# Vazias, o sistema usa o provedor simulado: a suíte, o `dev:memoria` e um
# clone recém-baixado rodam sem cadastro em lugar nenhum. Preenchidas, o Xepa
# passa a falar com a Pluggy de verdade — a escolha é feita pela presença
# destas variáveis, não por um import trocado à mão.
#
# Saem do dashboard da Pluggy (https://dashboard.pluggy.ai). Nunca versionar.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
